# Copy to .env and fill in. Never commit .env.

# --- Provider selection ---
FORGE_PROVIDER=ollama            # ollama | llamacpp
FORGE_MODE=confirm               # confirm (ask before mutating tools) | auto
# FORGE_MAX_STEPS=25             # LLM calls allowed per task
# FORGE_MAX_RESULT_CHARS=8000    # tool output sent back to the LLM is truncated to this

# --- Ollama (local) ---
OLLAMA_MODEL=gemma4:e2b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384           # context window; Ollama's default is too small for multi-step tool use
# OLLAMA_THINK=true              # stream the model's reasoning (shown as a status line)

# --- llama.cpp server (hosted, OpenAI-compatible) ---
# Base URL usually ends in /v1, e.g. https://your-host:8080/v1
LLAMACPP_BASE_URL=
LLAMACPP_API_KEY=
LLAMACPP_MODEL=qwen3.8-27b

# --- MCP servers ---
CONTEXT7_API_KEY=
